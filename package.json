{
  "name": "sf-run-club-index",
  "private": true,
  "version": "0.1.0",
  "description": "A research-backed directory of San Francisco running clubs",
  "license": "MIT",
  "author": "Michael D'Angelo",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "serve": "npm run generate && sirv . --dev --host 127.0.0.1 --port 4173",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "node --test tests/*.test.cjs tests/*.test.mts",
    "artwork": "node scripts/build_artwork.mts",
    "feed": "node scripts/build_feed.mts",
    "csv": "node scripts/build_clubs_csv.mts",
    "generate": "npm run site && npm run feed && npm run csv",
    "verify": "npm run check && npm run typecheck && npm test && npm run validate && npm run test:browser",
    "test:browser": "playwright test",
    "validate": "node scripts/validate.mts",
    "report": "node scripts/report.mts",
    "schedule": "node scripts/export_schedule.mts",
    "review": "node scripts/review_status.mts",
    "typecheck": "tsc",
    "site": "node scripts/build_site.mts",
    "pretest": "npm run site"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "sharp": "0.35.5",
    "sirv-cli": "3.0.1",
    "typescript": "7.0.2"
  }
}
